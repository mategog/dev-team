diff --git a/src/habits.js b/src/habits.js
index 74b2c81..b21b2c5 100644
--- a/src/habits.js
+++ b/src/habits.js
@@ -17,3 +17,20 @@ export function toggleDone(habits, id, day) {
     h.id !== id ? h : { ...h, done: h.done.includes(day) ? h.done.filter((d) => d !== day) : [...h.done, day] }
   );
 }
+
+// Days in a row done, ending today or (if today isn't ticked yet) yesterday. Future dates never count.
+export function currentStreak(done, today) {
+  const days = new Set(done);
+  // Previous calendar day via local y/m/d, not -24h, so DST days step correctly.
+  const prev = (key) => {
+    const [y, m, d] = key.split("-").map(Number);
+    return todayKey(new Date(y, m - 1, d - 1));
+  };
+  let day = days.has(today) ? today : prev(today);
+  let n = 0;
+  while (days.has(day)) {
+    n++;
+    day = prev(day);
+  }
+  return n;
+}
