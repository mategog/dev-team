--- a/test/habits.test.js
+++ b/test/habits.test.js
@@ -1,6 +1,6 @@
 import { test } from "node:test";
 import assert from "node:assert/strict";
-import { addHabit, toggleDone, todayKey } from "../src/habits.js";
+import { addHabit, currentStreak, toggleDone, todayKey } from "../src/habits.js";
 
 test("todayKey formats local date", () => {
   assert.equal(todayKey(new Date(2026, 0, 5)), "2026-01-05");
@@ -16,3 +16,58 @@ test("toggleDone adds then removes a day", () => {
   assert.deepEqual(on[0].done, ["2026-01-05"]);
   assert.deepEqual(toggleDone(on, h.id, "2026-01-05")[0].done, []);
 });
+
+test("currentStreak counts back from today", () => {
+  assert.equal(currentStreak(["2026-06-10", "2026-06-09", "2026-06-08"], "2026-06-10"), 3);
+});
+
+test("currentStreak counts back from yesterday when today is not done yet", () => {
+  const done = ["2026-06-09", "2026-06-08"];
+  assert.equal(currentStreak(done, "2026-06-10"), 2);
+  assert.equal(currentStreak([...done, "2026-06-10"], "2026-06-10"), 3);
+});
+
+test("currentStreak is 0 when last done 2+ days ago", () => {
+  assert.equal(currentStreak(["2026-06-08", "2026-06-07"], "2026-06-10"), 0);
+  assert.equal(currentStreak(["2026-05-01"], "2026-06-10"), 0);
+});
+
+test("currentStreak stops at a gap", () => {
+  const done = ["2026-06-10", "2026-06-09", "2026-06-07", "2026-06-06", "2026-06-05"];
+  assert.equal(currentStreak(done, "2026-06-10"), 2);
+});
+
+test("currentStreak empty, only today, only yesterday", () => {
+  assert.equal(currentStreak([], "2026-06-10"), 0);
+  assert.equal(currentStreak(["2026-06-10"], "2026-06-10"), 1);
+  assert.equal(currentStreak(["2026-06-09"], "2026-06-10"), 1);
+});
+
+test("currentStreak handles out-of-order and duplicate dates", () => {
+  const done = ["2026-06-08", "2026-06-10", "2026-06-09", "2026-06-10", "2026-06-08"];
+  assert.equal(currentStreak(done, "2026-06-10"), 3);
+});
+
+test("currentStreak ignores future dates and does not bridge through them", () => {
+  assert.equal(currentStreak(["2026-06-11", "2026-06-12"], "2026-06-10"), 0);
+  assert.equal(currentStreak(["2026-06-11", "2026-06-09"], "2026-06-10"), 1);
+  assert.equal(currentStreak(["2026-06-11", "2026-06-10", "2026-06-09"], "2026-06-10"), 2);
+});
+
+test("currentStreak crosses month and year boundaries", () => {
+  assert.equal(currentStreak(["2026-03-01", "2026-02-28", "2026-02-27"], "2026-03-01"), 3);
+  assert.equal(currentStreak(["2028-03-01", "2028-02-29", "2028-02-28"], "2028-03-01"), 3);
+  assert.equal(currentStreak(["2027-01-01", "2026-12-31", "2026-12-30"], "2027-01-01"), 3);
+});
+
+test("currentStreak steps calendar days across DST changes", () => {
+  assert.equal(currentStreak(["2026-03-30", "2026-03-29", "2026-03-28"], "2026-03-30"), 3);
+  assert.equal(currentStreak(["2026-10-26", "2026-10-25", "2026-10-24"], "2026-10-26"), 3);
+  assert.equal(currentStreak(["2026-03-09", "2026-03-08", "2026-03-07"], "2026-03-09"), 3);
+});
+
+test("currentStreak handles a long history", () => {
+  const done = [];
+  for (let i = 0; i < 1000; i++) done.push(todayKey(new Date(2026, 5, 10 - i)));
+  assert.equal(currentStreak(done, "2026-06-10"), 1000);
+});
